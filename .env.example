# ─── Site ────────────────────────────────────────────────────────────────
# Canonical public URL (used for metadata, sitemap, Open Graph and structured data).
NEXT_PUBLIC_SITE_URL=https://blackroid.com

# Optional: a public email address shown on the Contact page and footer.
# Leave empty to show no address (enquiries still go through the form).
NEXT_PUBLIC_CONTACT_EMAIL=blackroid@gmail.com

# Optional: address of the client portal login. The Client Portal links (header, mobile menu,
# footer) appear only when this is set, e.g. https://portal.blackroid.com
NEXT_PUBLIC_CLIENT_PORTAL_URL=

# Optional: search console ownership verification tokens (meta tag content values).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ─── Contact form delivery ───────────────────────────────────────────────
# Where enquiries are delivered. Defaults to blackroid@gmail.com if unset.
CONTACT_TO_EMAIL=blackroid@gmail.com

# Sender address. Must be a domain verified with your email provider.
CONTACT_FROM_EMAIL="Blackroid <no-reply@blackroid.com>"

# Option A — Resend (https://resend.com). Used if set.
RESEND_API_KEY=

# Option B — any SMTP provider. Used if RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "true" for port 465 (implicit TLS); "false" for STARTTLS on 587.
SMTP_SECURE=false
